APP_NAME=DocMind
APP_ENV=development
LOG_LEVEL=INFO

# Google Gemini API Key (Lấy tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (Mặc định dùng SQLite cục bộ, hoặc đổi sang PostgreSQL nếu cần)
DATABASE_URL=sqlite:///./docmind.db
# DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/docmind

# Redis & ARQ Queue Settings
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant Vector DB Settings (Phase 9.1)
QDRANT_HOST=localhost
QDRANT_PORT=6333
USE_QDRANT=true

# Embedding & CRAG Gatekeeper Settings (Phase 9.1 - 9.3)
EMBEDDING_PROVIDER=bge
ENABLE_GATEKEEPER=true
GATEKEEPER_ACCEPT_THRESHOLD=0.70
GATEKEEPER_REJECT_THRESHOLD=0.35
ENABLE_FAITHFULNESS_VERIFIER=true

# Langfuse Observability Settings (Phase 9.4)
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
