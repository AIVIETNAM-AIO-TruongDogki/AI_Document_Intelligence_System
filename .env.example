# =============================================================
# DocMind System Environment Configuration
# =============================================================

# Khóa xác thực LLM Gemini (Nếu để trống, hệ thống tự động dùng MockLLMProvider)
GEMINI_API_KEY=

# Cấu hình PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=docmind

# Cổng truy cập ngoài (Host Port Mapping)
BACKEND_PORT=8000
FRONTEND_PORT=3000
REDIS_PORT=6379
POSTGRES_PORT=5432
QDRANT_PORT=6333
LANGFUSE_PORT=3001

# Tùy chọn Langfuse Observability
NEXTAUTH_SECRET=docmind_nextauth_secret_key_12345
LANGFUSE_SALT=docmind_langfuse_salt_key_12345
